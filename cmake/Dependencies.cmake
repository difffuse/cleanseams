set(CS_DEPENDENCY_LOCK "${PROJECT_SOURCE_DIR}/deps.lock.json" CACHE FILEPATH "Exact dependency manifest")
file(READ "${PROJECT_SOURCE_DIR}/cmake/deps.lock.sha256" expected_lock)
string(STRIP "${expected_lock}" expected_lock)
file(SHA256 "${CS_DEPENDENCY_LOCK}" CS_LOCK_SHA256)
if(NOT CS_LOCK_SHA256 STREQUAL expected_lock)
  message(FATAL_ERROR "Dependency lock mismatch: review lock and update cmake/deps.lock.sha256 together")
endif()
file(READ "${CS_DEPENDENCY_LOCK}" CS_LOCK)
string(JSON schema GET "${CS_LOCK}" schema_version)
if(NOT schema EQUAL 1)
  message(FATAL_ERROR "Unknown dependency lock schema")
endif()
set(CS_DOWNLOAD_CACHE "${PROJECT_SOURCE_DIR}/build/downloads" CACHE PATH "Verified archive cache")
file(MAKE_DIRECTORY "${CS_DOWNLOAD_CACHE}")
function(cs_dependency name)
  string(JSON count LENGTH "${CS_LOCK}" dependencies)
  math(EXPR last "${count} - 1")
  set(found FALSE)
  foreach(index RANGE ${last})
    string(JSON entry GET "${CS_LOCK}" dependencies ${index})
    string(JSON entry_name GET "${entry}" name)
    if(entry_name STREQUAL name)
      set(found TRUE)
      break()
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Missing locked dependency: ${name}")
  endif()
  string(JSON url GET "${entry}" url)
  string(JSON sha GET "${entry}" sha256)
  set(archive "${CS_DOWNLOAD_CACHE}/${name}-${sha}.tar.gz")
  if(NOT EXISTS "${archive}")
    file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${sha}" TLS_VERIFY ON STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "Dependency download failed: ${name}: ${status}")
    endif()
  endif()
  file(SHA256 "${archive}" actual)
  if(NOT actual STREQUAL sha)
    message(FATAL_ERROR "Dependency archive checksum mismatch: ${name}")
  endif()
  # Extract fresh verified bytes for each configure; cached source edits cannot bypass the lock.
  set(destination "${PROJECT_BINARY_DIR}/_deps/${name}-src")
  file(REMOVE_RECURSE "${destination}")
  file(MAKE_DIRECTORY "${destination}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
  file(GLOB roots LIST_DIRECTORIES TRUE "${destination}/*")
  list(LENGTH roots roots_count)
  if(NOT roots_count EQUAL 1)
    message(FATAL_ERROR "Expected one source root in ${name}")
  endif()
  list(GET roots 0 source)
  set(${name}_SOURCE_DIR "${source}" PARENT_SCOPE)
  set(${name}_BINARY_DIR "${PROJECT_BINARY_DIR}/_deps/${name}-build" PARENT_SCOPE)
endfunction()
