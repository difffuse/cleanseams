@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/CleanSeamsTargets.cmake")
set(CleanSeams_VERSION "@PROJECT_VERSION@")
set(CleanSeams_HAS_BINDING "@CS_BUILD_BINDINGS@")
set(CleanSeams_PYTHON_SOABI "@Python_SOABI@")
if(CleanSeams_HAS_BINDING)
  set_and_check(CleanSeams_PYTHON_DIR "@PACKAGE_CS_INSTALL_PYTHONDIR@")
endif()
check_required_components(CleanSeams)
