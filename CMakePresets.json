{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CS_BUILD_BINDINGS": false,
        "CS_BUILD_TESTS": true
      }
    },
    {
      "name": "native-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "inherits": "native-debug",
      "cacheVariables": {
        "CS_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "native-debug",
      "cacheVariables": {
        "CS_SANITIZER": "thread"
      }
    },
    {
      "name": "macos-release",
      "inherits": "native-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "jobs": 4
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "jobs": 4
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "jobs": 4
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "jobs": 4
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
